# mod secrets. Lives at ~/.mod/env; edit with `mod config`.
# Any value here can be referenced from mod.config.json as ${NAME}.

# Used by the rpc urls in the example mod.config.json.
export INFURA_API_KEY=

# Keystore accounts, as created by `mod wallet` / `cast wallet`.
export ETH_KEYSTORE_DIR=~/.foundry/keystores
# File holding the keystore password, so cast, forge and `mod pk` do not
# prompt for it. Set it with `mod config password`.
export ETH_PASSWORD_FILE=~/.foundry/keystore_password

# Solana keypairs, managed by `mod wallet sol`.
export SOL_KEYPAIR_DIR=~/.config/solana/keys

# Needed by `mod tenderly` and by FORK=true.
# export TENDERLY_ORG=
# export TENDERLY_PROJECT=
# export TENDERLY_API_KEY=

# Needed by `mod verify` with the matching verifier.
# export ETHERSCAN_API_KEY=
# export BLASTSCAN_API_KEY=

# Needed by `mod wallet`, `mod e2e` and `mod trace`.
# export OPTIMISM_MONOREPO_ROOT=
